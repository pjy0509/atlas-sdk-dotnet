<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 reaches .NET Framework 4.6.1+, .NET Core/5+, UWP, WinUI
       and Unity (docs/sdk-cautions.md §3); the windows TFM adds the WinRT
       campaign-id read so a packaged app claims its deferred link with no
       extra code. NuGet picks the asset per host. Zero dependencies. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0-windows10.0.17763.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>AppAtlas.Sdk</RootNamespace>
    <AssemblyName>AppAtlas.Sdk</AssemblyName>
    <Version>0.4.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet metadata. The package is pushed from a tag; the API key comes
       from the environment, never this repo. -->
  <PropertyGroup>
    <PackageId>AppAtlas.Sdk</PackageId>
    <Authors>Park Jungyoung</Authors>
    <Description>App Atlas SDK for .NET: deep-link inflow, crash reporting and telemetry. Unhandled exceptions from every hook the host has, native deaths through WER LocalDumps, UI hangs, sessions. Runs on .NET Framework 4.6.1+, .NET Core/5+, UWP, WinUI and Unity; on Windows targets a packaged app claims its deferred link automatically.</Description>
    <PackageProjectUrl>https://appatlas.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pjy0509/atlas-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>appatlas;deeplink;attribution;crash;crashlytics;telemetry</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- The targets every consumer imports: the key from the project file, the startup hook. -->
    <None Include="buildTransitive/AppAtlas.Sdk.targets" Pack="true" PackagePath="buildTransitive/;build/" />
  </ItemGroup>

</Project>
